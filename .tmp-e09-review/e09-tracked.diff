+    expect(goldset.reviewTimestamp).toBeTruthy();
+    expect(goldset.skeleton).toMatch(/Brand/);
+  });
+
+  it('splits partition FAMILIES (not SKUs) into disjoint train/test/holdout', () => {
+    expect(goldset.splits.strategy).toBe('by-family');
+    const familyIds = goldset.families.map(family => family.familyId).sort();
+    const splitIds = [...goldset.splits.train, ...goldset.splits.test, ...goldset.splits.holdout].sort();
+    expect(splitIds).toEqual(familyIds);
+    const all = new Set(splitIds);
+    expect(all.size).toBe(splitIds.length);
+  });
+
+  it('every family carries adjudication provenance and stable Page IDs', () => {
+    for (const family of goldset.families) {
+      expect(family.groupingVersion).toBe('product-family-v1');
+      expect(family.reviewer).toBeTruthy();
+      expect(family.reviewTimestamp).toBeTruthy();
+      expect(family.reviewStatus).toBe('approved');
+      expect(family.adjudicationRationale).toBeTruthy();
+      expect(Array.isArray(family.expectedTitles)).toBe(true);
+      expect(family.expectedTitles.length).toBe(family.members.length);
+      for (const pageId of [
+        ...(family.expectedPrimaryPageIds ?? []),
+        ...(family.allowedSecondaryPageIds ?? []),
+        ...(family.forbiddenPageIds ?? []),
+      ]) {
+        expect(pageId).toMatch(/^page_/);
+      }
+      for (const member of family.members) {
+        expect(member.onboardingItemId).toBeTruthy();
+        expect(member.upc).toBeTruthy();
+        expect(member.frozenEvidenceHash).toMatch(/.+/);
+        expect(member.expectedTitle).toBeTruthy();
+        expect(Array.isArray(member.requiredTokens)).toBe(true);
+        expect(Array.isArray(member.forbiddenSiblingTokens)).toBe(true);
+      }
+    }
+  });
+
+  it('synthetic scenarios are explicitly labeled and separated from production-attested ones', () => {
+    for (const family of goldset.families) {
