+      if (family.isSynthetic) {
+        expect(family.syntheticNote).toMatch(/synthetic/i);
+      }
+    }
+    // Scaffold state pin (Plan §12): until the verified backup export lands,
+    // EVERY family is synthetic — none may claim production attestation.
+    const synthetic = goldset.families.filter(family => family.isSynthetic);
+    const attested = goldset.families.filter(family => !family.isSynthetic);
+    expect(synthetic.length).toBe(goldset.families.length);
+    expect(attested.length).toBe(0);
+  });
+});
