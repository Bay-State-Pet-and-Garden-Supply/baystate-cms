+/**
+ * e09 Phase C — goldset-driven validation tests.
+ *
+ * Fixture under test: src/tests/fixtures/family-title-page-goldset-v2.json
+ * Plan §12 contract: by-family entries, STABLE Page IDs (never names),
+ * frozenEvidenceHash per member, explicit synthetic labeling, reviewer +
+ * adjudication rationale, and train/test/holdout splits that partition
+ * FAMILIES (never SKUs) without overlap.
+ *
+ * The fixture is currently the SYNTHETIC scaffold (Plan §12/Phase A): these
+ * tests execute the real validators against it AND enforce the labeling
+ * discipline that keeps synthetic scenarios out of production-attested claims.
+ */
+import { describe, it, expect } from 'vitest';
+import fs from 'fs';
+import path from 'path';
+import { validateFamilyTitleSet } from '../../classification/family-title-consistency';
+import type { TitleFrozenFacts } from '../../classification/family-title-consistency';
+import { validateCategoryPageAssignment } from '../../classification/category-page-correctness';
+import type { PageCorrectnessInput } from '../../classification/category-page-correctness';
+
+// ─── Fixture ────────────────────────────────────────────────────────────────
+
+interface GoldsetMember {
+  onboardingItemId: string;
+  upc: string;
+  rawTitle?: string;
+  frozenEvidenceHash: string;
+  frozenEvidence?: Record<string, unknown>;
+  frozenEvidenceSpecies?: string[];
+  expectedTitle: string;
+  requiredTokens: string[];
+  forbiddenSiblingTokens: string[];
+}
+interface GoldsetFamily {
+  familyId: string;
+  groupKey: string;
+  groupingVersion: string;
+  isSynthetic: boolean;
+  syntheticNote?: string;
+  expectedTitleSkeleton?: string;
+  expectedTitleSlots?: Record<string, string>;
+  adjudicationRationale: string;
+  reviewer: string;
+  reviewTimestamp: string;
+  reviewStatus: string;
+  members: GoldsetMember[];
+  expectedTitles: string[];
+  expectedPrimaryPageIds: string[];
+  allowedSecondaryPageIds?: string[];
+  forbiddenPageIds?: string[];
+  coPrimaryEncodingNote?: string;
+}
+interface Goldset {
+  version: number;
+  activePageImportHash: string;
+  modelExecutionPlanHash: string;
+  reviewer: string;
+  reviewTimestamp: string;
+  skeleton: string;
+  splits: { strategy: string; train: string[]; test: string[]; holdout: string[] };
+  families: GoldsetFamily[];
+}
+
+const fixturePath = path.join(__dirname, '..', 'fixtures', 'family-title-page-goldset-v2.json');
+const goldset: Goldset = JSON.parse(fs.readFileSync(fixturePath, 'utf-8'));
+
+// ─── Catalog fixture mirroring the goldset's referenced stable Page IDs ─────
+
+const CATALOG: PageCorrectnessInput['verifiedPageCatalog'] = [
+  { id: 'page_jerky_dog_treats', name: 'Jerky Dog Treats', parentId: null },
+  { id: 'page_shop_all_dog_treats', name: 'Dog Treats Shop All', parentId: null },
+  { id: 'page_cat_treats', name: 'Cat Treats', parentId: null },
+  { id: 'page_bones_bully_sticks_natural_chews', name: 'Dog Treats — Bones, Bully Sticks & Natural Chews', parentId: null },
+  { id: 'page_dog_treats_general', name: 'Dog Treats', parentId: null },
+  { id: 'page_cat_treats_general', name: 'Cat Treats', parentId: null },
+  { id: 'page_dog_toys_chew', name: 'Dog Toys — Chew Toys', parentId: null },
+  { id: 'page_brand_betterbone', name: 'Brand - BetterBone', parentId: null },
+  { id: 'page_brand_acme', name: 'Brand - Acme', parentId: null },
+];
+
+// ─── Frozen-facts derivation from the ratified slot contract ────────────────
+
+const SIZE_TOKEN_RE = /^(small|medium|large|x-large|\d+\s*(lb|oz|kg|g|count|ct|pack))$/i;
+const MODIFIER_TOKENS = new Set(['soft', 'hard', 'classic', 'hypoallergenic', 'hypo']);
+
+function frozenFactsFor(family: GoldsetFamily, member: GoldsetMember): TitleFrozenFacts {
+  const slots = family.expectedTitleSlots ?? {};
+  const brand = String(slots.brand ?? '');
+  const productLine = String(slots.productLine ?? brand);
+  const lower = member.requiredTokens.map(token => token.toLowerCase());
+  const isSize = (token: string) => SIZE_TOKEN_RE.test(token);
+  const isFlavor = (token: string) =>
+    !MODIFIER_TOKENS.has(token.toLowerCase()) &&
+    !isSize(token) &&
+    token.toLowerCase() !== brand.toLowerCase() &&
+    token.toLowerCase() !== productLine.toLowerCase();
+  return {
+    brand,
+    productLine,
+    flavorOrColorOrSubline: member.requiredTokens.find(isFlavor),
+    sizeOrCount: member.requiredTokens.find(isSize),
+    modifiers: {
+      soft: lower.includes('soft'),
+      hard: lower.includes('hard'),
+      classic: lower.includes('classic'),
+      hypoallergenic: lower.includes('hypoallergenic') || lower.includes('hypo'),
+    },
+  };
+}
+
+function pageInput(
+  member: GoldsetMember,
+  primaryPageId: string | null,
+  secondaryPageIds: string[],
