{
  "name": "@baystate/shopsite-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "vite build && tsc --noEmit",
    "start": "bun run src/server/index.ts",
    "test": "vitest run && bun test src/tests/unit/db-migration.test.ts src/tests/integration/phase2-change-set.test.ts src/tests/integration/phase3-sync-drift.test.ts",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:db": "bun test src/tests/unit/db-migration.test.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.2.1",
    "hono": "^4.7.0",
    "fast-xml-parser": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
