+  sourceUrl: string;
+  sourceType: string;
+  extractionMethod: string;
+  retrievedAt: string;
+  originalContentHash: string;
+  perceptualHash?: string | null;
+  rightsStatus: 'approved' | 'restricted' | 'unknown';
+  rightsBasis?: string | null;
+  rightsEvidenceRef?: string | null;
+  observedBrand?: string | null;
